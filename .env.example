# Salin file ini menjadi .env (untuk lokal) dan isi di Vercel → Settings → Environment Variables
# DATABASE_URL didapat dari Neon → Dashboard → Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Kredensial login admin online (jangan pakai spasi)
ADMIN_USER=admin
# Boleh teks biasa, atau hash bcrypt diawali $2y$ (buat via: node -e "console.log(require('bcryptjs').hashSync('pass',10))")
ADMIN_PASS=ganti-password-kuat

# Kunci rahasia untuk tanda tangan JWT admin (isi string acak panjang-min 32 karakter)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=isi-min-32-karakter-acak-jangan-dibagikan
